---
import Header from '../components/Header.astro';
import { site, nav } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} | Supported Living Services in Sacramento and Yolo Counties`,
  description = site.description,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_US" />
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:wght@400;700&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p><strong>{site.name}</strong>, part of {site.legalName}. {site.tagline}</p>
        <nav aria-label="Footer">
          <ul class="inline-list">
            {nav.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
            <li><a href="#contact">Contact</a></li>
          </ul>
        </nav>
        <p>Serving the Alta California Regional Center area.</p>
        <p>{site.nondiscrimination}</p>
        <p>&copy; {new Date().getFullYear()} {site.legalName}. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
